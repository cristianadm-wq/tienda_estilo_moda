# Copia este archivo como .env. No compartas ni subas .env a GitHub.
# URI para MongoDB local configurado como replica set. Si usas Atlas, reemplázalo por tu URI.
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
SECRET_KEY=REEMPLAZA_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
# Solo hace falta para configurar un primer admin cuando todavía no existe uno.
# Elimina esta variable del entorno después de crear esa cuenta.
ADMIN_SETUP_KEY=REEMPLAZA_POR_UNA_CLAVE_TEMPORAL
